#the mod name as displayed in-game
displayName: "Testing Utilities Unlocked"

#the internal name of your mod
name: "test-utils-u"

#your name
author: "MEEP of Faith"

#the fully qualified main class of the mod
main: "testing.TestUtils"

#mod repo on github
repo: Sedrowow/testing-utilities-java-unlocked

#the mod description as seen in the mod dialog
description: "Utilities for testing stuff in sandbox and career. (Load the game with this mod enabled for more info.)"

#short description displayed under the title
subtitle: "Easier to use than the console and more cheaty."

version: 69.8

#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true

#doesn't have content; client-sided
hidden: true
